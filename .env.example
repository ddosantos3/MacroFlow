# MacroFlow - exemplo de configuracao
# Copie este arquivo para .env e preencha somente o que for usar.
# Nunca versione o .env real, pois ele pode conter chaves, senhas e tokens.


# Servidor local
# Define onde o dashboard FastAPI fica disponivel.
MACROFLOW_HOST=127.0.0.1
MACROFLOW_PORT=8000


# Persistencia e artefatos
# Controla onde ficam JSON de estado, historico, auditoria e Excel exportado.
MACROFLOW_RUNTIME_DIR=
MACROFLOW_EXCEL_PATH=
MACROFLOW_DASHBOARD_STATE_PATH=
MACROFLOW_SNAPSHOT_HISTORY_PATH=
MACROFLOW_DECISION_AUDIT_PATH=


# Yahoo Finance - dados de mercado e graficos
# Fonte publica usada para candles, proxies e timeframes visuais do dashboard.
MACROFLOW_YAHOO_INTRADAY_PERIOD=60d
MACROFLOW_YAHOO_INTRADAY_INTERVAL=60m
MACROFLOW_YAHOO_DAILY_PERIOD=1y
MACROFLOW_YAHOO_DAILY_INTERVAL=1d
MACROFLOW_CHART_DEFAULT_TIMEFRAME=4H


# FRED - proxies macro obrigatorios
# DXY e US10Y entram no filtro macro. Sem chave valida, o sistema bloqueia por desenho.
FRED_API_KEY=
MACROFLOW_FRED_DXY=DTWEXBGS
MACROFLOW_FRED_US10Y=DGS10


# Nucleo operacional e risco
# Parametros gerais de score, capital, risco e leitura estrutural.
MACROFLOW_CAPITAL_TOTAL_BRL=
MACROFLOW_SCORE_MINIMO_OPERAR=65
MACROFLOW_RISCO_MAXIMO_POR_OPERACAO=0.01
MACROFLOW_RSI_PERIODO=14
MACROFLOW_EMA_FAST=9
MACROFLOW_EMA_SLOW=21
MACROFLOW_STOP_BUFFER_PCT=0.005
MACROFLOW_TOUCH_TOLERANCE_PCT=0.0025
MACROFLOW_MACRO_DELTA_BARS=5
MACROFLOW_VOLUME_LOOKBACK=50


# Motor quant - indicadores, volatilidade e sizing
# Configura VWAP, POC, ATR, Bollinger, volume, ADX, medias e risco do motor quant.
MACROFLOW_VWAP_ROLLING_WINDOW=20
MACROFLOW_POC_BINS=24
MACROFLOW_VALUE_AREA_PCT=0.70
MACROFLOW_ATR_PERIOD=14
MACROFLOW_BB_PERIOD=20
MACROFLOW_BB_STD=2.0
MACROFLOW_SQUEEZE_WINDOW=20
MACROFLOW_VOLUME_AVERAGE_WINDOW=20
MACROFLOW_VOLUME_SPIKE_FACTOR=1.5
MACROFLOW_ADX_PERIOD=14
MACROFLOW_QUANT_EMA_FAST=8
MACROFLOW_QUANT_EMA_MID=21
MACROFLOW_QUANT_EMA_SLOW=80
MACROFLOW_QUANT_EMA_LONG=200
MACROFLOW_ATR_HIGH_QUANTILE_WINDOW=60
MACROFLOW_ATR_HIGH_QUANTILE=0.75
MACROFLOW_QUANT_RISK_PERCENT=0.01
MACROFLOW_QUANT_MAX_RISK_PERCENT=0.02
MACROFLOW_STOP_ATR_MULTIPLE=2.0
MACROFLOW_TARGET_ATR_MULTIPLE=3.0


# MacroFlow v2 - motor decisorio intraday
# Gates de horario, latencia, range, volume, fluxo, risco-retorno e travas diarias.
MACROFLOW_V2_TRADING_START=09:05
MACROFLOW_V2_TRADING_END=17:25
MACROFLOW_V2_NO_TRADE_FIRST_MINUTES=5
MACROFLOW_V2_NO_NEW_ENTRIES_BEFORE_CLOSE_MINUTES=10
MACROFLOW_V2_MAX_DATA_LATENCY_SECONDS=90
MACROFLOW_V2_PROXY_MAX_LATENCY_SECONDS=600
MACROFLOW_V2_ORDERFLOW_MAX_LATENCY_SECONDS=30
MACROFLOW_V2_MIN_RANGE_BRA50=250
MACROFLOW_V2_MIN_RANGE_USDBRL=0.01
MACROFLOW_V2_MIN_RVOL=1.20
MACROFLOW_V2_IMBALANCE_LONG_THRESHOLD=0.15
MACROFLOW_V2_IMBALANCE_SHORT_THRESHOLD=-0.15
MACROFLOW_V2_MIN_RISK_REWARD=2.0
MACROFLOW_V2_WEAK_BIAS_THRESHOLD=0.25
MACROFLOW_V2_STRONG_BIAS_THRESHOLD=0.80
MACROFLOW_V2_MAX_STOP_ATR_MULTIPLE=2.5
MACROFLOW_V2_DEFAULT_RISK_PERCENT=0.005
MACROFLOW_V2_DAILY_RISK_PERCENT=0.02
MACROFLOW_V2_MAX_TRADES_PER_ASSET=3
MACROFLOW_V2_MAX_CONSECUTIVE_LOSSES=2


# Envio por e-mail - SMTP
# Envia alertas/relatorios quando habilitado. Use senha de app quando o provedor exigir.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SEND_MODE=signal_or_daily
EMAIL_USE_TLS=true


# OpenAI / LLM
# Opcional. Gera explicacao textual; nao decide entrada, stop, alvo ou sizing.
MACROFLOW_LLM_ENABLED=false
MACROFLOW_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MACROFLOW_LLM_TIMEOUT_SECONDS=20


# Calendario economico
# Fonte de eventos que complementa contexto. Nao substitui as regras deterministicas.
MACROFLOW_CALENDAR_ENABLED=true
MACROFLOW_CALENDAR_PROVIDER=forexfactory
TRADING_ECONOMICS_API_KEY=guest:guest
MACROFLOW_CALENDAR_COUNTRIES=United States,Brazil,Euro Area,China
MACROFLOW_CALENDAR_IMPORTANCE_MIN=1
MACROFLOW_CALENDAR_DAYS_BACK=1
MACROFLOW_CALENDAR_DAYS_AHEAD=7
MACROFLOW_CALENDAR_TIMEOUT_SECONDS=15
MACROFLOW_CALENDAR_MAX_EVENTS=80


# Jarvis
# Configura prompt local, tamanho de historico e volume de contexto enviado ao assistente.
MACROFLOW_JARVIS_PROMPT_PATH=prompt.txt
MACROFLOW_JARVIS_MAX_HISTORY_MESSAGES=8
MACROFLOW_JARVIS_MAX_CONTEXT_EVENTS=12
MACROFLOW_JARVIS_MAX_CONTEXT_ASSETS=6
